{
  "headers": [
    {
      "source": "/data.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/stream-proxy/(.*)",
      "destination": "https://in-mc-fdlive.fancode.com/$1",
      "headers": {
        // This tricks the stream server into thinking the request originated from its own domain
        "Referer": "https://in-mc-fdlive.fancode.com/", 
        // This makes the request look like a standard Chrome browser
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/100.0.4896.75 Safari/537.36"
      }
    }
  ]
}
