{
  "headers": [
    {
      "source": "/data.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/stream-proxy/(.*)",
      "destination": "https://in-mc-fdlive.fancode.com/$1"
    }
  ]
}
